{
    "compilerOptions": {
	"target": "ESNext",
	"module": "NodeNext",
	"rootDir": "src",
	"outDir": "dist",
	"sourceMap": true,
	"strict": true,
	"noImplicitOverride": true,
	"noImplicitAny": true,
	"declaration": true,
	"lib": ["ES2022"],
	"types": ["node"],
	"paths": {
	    "lib/*": ["./src/lib/*"]
	}
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
}
